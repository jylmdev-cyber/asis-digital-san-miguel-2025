{
  "name": "asis-digital-san-miguel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "test": "node --test tests/data.test.mjs",
    "qa": "node scripts/browser-qa.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "pages:validate": "node scripts/validate-pages.mjs",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "pages:deploy": "npm run pages:validate && wrangler pages deploy dist"
  },
  "dependencies": {
    "@astrojs/react": "latest",
    "astro": "^7.3.7",
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@axe-core/playwright": "latest",
    "@playwright/test": "latest",
    "@types/leaflet": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "qrcode": "^1.5.4",
    "typescript": "latest",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "sharp": "^0.35.5"
  }
}
